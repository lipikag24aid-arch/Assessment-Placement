# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
FACULTY_SIGNUP_KEY=choose-a-private-key-for-faculty-sign-up
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# ---- HTTPS ----
# USE_HTTPS=0 serves plain http:// (no browser warning; QR codes use http). Set 1 for HTTPS with a self-signed certificate.
USE_HTTPS=0
# Use your own certificate instead (optional):
# PORTAL_SSL_CERT=C:\path\to\fullchain.pem
# PORTAL_SSL_KEY=C:\path\to\privkey.pem
# Extra hostnames/IPs to put on the self-signed certificate (comma separated):
# CERT_HOSTS=portal.college.edu
# Set to 1 when nginx / Caddy / your host already provides HTTPS in front of the app:
BEHIND_PROXY=0
# HOST=0.0.0.0 lets students on the same network connect; PORT defaults to 5000.
